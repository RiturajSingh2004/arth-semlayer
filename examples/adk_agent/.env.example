# Model Configuration
MODEL_NAME=gemini-3.7-flash

# Google Cloud / Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
# Uncomment one authentication mode below when running the live agent:
# GOOGLE_GENAI_USE_VERTEXAI=True
# GEMINI_API_KEY=your-gemini-api-key

# Semantic Layer Configuration
# Set SEMLAYER_WAREHOUSE=duckdb for zero-credential offline mode (auto-seeds jaffle_shop),
# or SEMLAYER_WAREHOUSE=bigquery to query Google's managed BigQuery MCP server.
SEMLAYER_WAREHOUSE=duckdb
SEMLAYER_DEFAULT_ROLE=finance
SEMLAYER_BQ_PROJECT=YOUR_PROJECT_ID
SEMLAYER_BQ_DATASET=jaffle_shop
SEMLAYER_BQ_MCP_URL=https://bigquery.googleapis.com/mcp
SEMLAYER_BQ_SERVICE_ACCOUNT=
SEMLAYER_BQ_MAX_BYTES=100000000
SEMLAYER_REGISTRY_DIR=
SEMLAYER_STATE_DIR=
SEMLAYER_DUCKDB_PATH=

# Web Server & Telemetry Configuration
ALLOW_ORIGINS=
LOGS_BUCKET_NAME=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
GENAI_TELEMETRY_PATH=completions
COMMIT_SHA=dev
